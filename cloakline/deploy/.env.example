# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.

# The domain this instance will serve. Must have an A/AAAA record pointing
# to the VPS's IP address. Caddy will auto-provision a Let's Encrypt cert.
DOMAIN=gateway.example.com

# Email for Let's Encrypt registration + urgent Caddy notifications.
ADMIN_EMAIL=you@example.com

# Bcrypt hash for the /metrics basic-auth. Generate with:
#     docker run --rm caddy:2-alpine caddy hash-password
# Enter password when prompted; paste the hash below (starts with $2a$14$...).
# Use single quotes to avoid shell expansion of the $ signs.
ADMIN_PASSWORD_HASH='REPLACE_WITH_BCRYPT_HASH'

# Real cloud API keys — held server-side. Clients never see these.
OPENAI_API_KEY=sk-your-real-openai-key
ANTHROPIC_API_KEY=sk-ant-your-real-anthropic-key

# Log level: debug | info | warn | error
# WARNING: pipeline.yaml has env: dev by default. If you set env: prod there,
# the gateway REFUSES to boot with LOG_LEVEL=debug (governance invariant).
LOG_LEVEL=info
